<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme: Compose handles the real colors -->
    <style name="Theme.NetCut" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Splash screen theme (androidx core-splashscreen) -->
    <style name="Theme.NetCut.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.NetCut</item>
    </style>
</resources>
